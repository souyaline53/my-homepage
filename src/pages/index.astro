---
const pageTitle = "時代の先端をいくサイト にちか.com";
const lang = "ja";

const newsItems = [
	{ date: "2024.05.20", title: "ポートフォリオサイトをリニューアルしました。" },
	{ date: "2024.05.15", title: "「温泉巡り」の記事をアップしました。" },
	{ date: "2024.05.10", title: "新しい開発プロジェクトに参加します。" },
	{ date: "2024.05.01", title: "5月の活動報告を掲載しました。" },
	{ date: "2024.04.25", title: "Researchページを更新しました。" },
];
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<header>
			<div class="header-container">
				<div class="logo">にちか.com</div>
				<nav>
					<ul class="nav-links">
						<li><a href="/about">About me</a></li>
						<li class="dropdown">
							<a href="/blog" class="dropbtn">Blog</a>
							<div class="dropdown-content">
								<a href="/blog/agriculture">agriculture</a>
								<a href="/blog/research">research</a>
								<a href="/blog/travel">travel</a>
								<a href="/blog/onsen">onsen</a>
								<a href="/blog/development">development</a>
							</div>
						</li>
						<li><a href="/service">Service</a></li>
						<li><a href="/fanclub">Fan club</a></li>
						<li><a href="/contact">Contact</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<main>
			<section class="hero">
				<div class="hero-image">
					<img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=2072&auto=format&fit=crop" alt="Hero background" />
				</div>
				<div class="hero-text">
					<h1>時代の先端をいくサイト<br>にちか.com</h1>
				</div>
			</section>

			<section class="whats-new">
				<div class="container">
					<h2>What’s new</h2>
					<ul>
						{newsItems.map((item) => (
							<li>
								<span class="date">{item.date}</span>
								<span class="title">{item.title}</span>
							</li>
						))}
					</ul>
				</div>
			</section>

			<section class="profile">
				<div class="container">
					<h2>Profile</h2>
					<div class="profile-content">
						<div class="profile-icon">
							<img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=300&h=300&auto=format&fit=crop" alt="Profile" />
						</div>
						<div class="profile-details">
							<h3>にちか / Nichika</h3>
							<p>開発、農業、そして旅を愛するエンジニアです。技術の力で新しい価値を生み出すことに情熱を注いでいます。週末は温泉を巡りながらリサーチ活動を行っています。</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer>
			<p>&copy; 2024 にちか.com</p>
		</footer>
	</body>
</html>

<style>
	:root {
		--primary-color: #333;
		--accent-color: #0070f3;
	}
	body {
		margin: 0;
		padding: 0;
		font-family: 'Noto Sans JP', sans-serif;
		color: var(--primary-color);
		line-height: 1.6;
	}
	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 4rem 1rem;
	}

	/* Header Styles */
	header {
		position: fixed;
		top: 0;
		width: 100%;
		z-index: 10;
		padding: 1rem 0;
		background-color: rgba(0, 0, 0, 0.3);
		backdrop-filter: blur(10px);
	}
	.header-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}
	.logo { color: white; font-weight: bold; font-size: 1.5rem; }
	.nav-links { display: flex; list-style: none; gap: 2rem; margin: 0; }
	.nav-links a { color: white; text-decoration: none; font-weight: bold; }

	/* Dropdown */
	.dropdown { position: relative; display: inline-block; }
	.dropdown-content {
		display: none;
		position: absolute;
		background-color: white;
		min-width: 160px;
		box-shadow: 0px 8px 16px rgba(0,0,0,0.2);
		z-index: 1;
	}
	.dropdown-content a { color: #333; padding: 12px 16px; display: block; }
	.dropdown-content a:hover { background-color: #f1f1f1; }
	.dropdown:hover .dropdown-content { display: block; }

	/* Hero Styles */
	.hero { position: relative; height: 100vh; overflow: hidden; }
	.hero-image { width: 100%; height: 100%; }
	.hero-image img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.6); }
	.hero-text {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		text-align: center;
		color: white;
		width: 100%;
	}
	.hero-text h1 { font-size: 3.5rem; letter-spacing: 0.1rem; margin: 0; }

	/* What's New & Profile */
	.whats-new ul { list-style: none; padding: 0; }
	.whats-new li { border-bottom: 1px solid #eee; padding: 1rem 0; display: flex; gap: 2rem; }
	.date { color: #888; font-family: monospace; }

	.profile { background: #fafafa; }
	.profile-content { display: flex; align-items: center; gap: 3rem; margin-top: 2rem; }
	.profile-icon img { width: 150px; height: 150px; border-radius: 50%; object-fit: cover; }
	.profile-details h3 { margin-top: 0; }

	footer { text-align: center; padding: 2rem; border-top: 1px solid #eee; }

	@media (max-width: 768px) {
		.hero-text h1 { font-size: 2rem; }
		.header-container {
			flex-direction: column;
			gap: 0.5rem;
		}
		.nav-links {
			gap: 0.8rem;
			font-size: 0.8rem;
			padding: 0;
		}
		.profile-content { flex-direction: column; text-align: center; }
	}
</style>
