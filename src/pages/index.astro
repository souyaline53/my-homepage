---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "時代の先端を逝くサイト にちか.com";

const allPosts = await getCollection('blog');
const newsItems = [...allPosts]
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
	.slice(0, 5);
---

<BaseLayout title={pageTitle} headerOpacity="0.3">
	<main>
			<section class="hero">
				<div class="hero-image">
					<img src="/images/hero.JPG" alt="Hero" />
				</div>
				<div class="hero-text">
					<h1>時代の先端を行くサイト<br>にちか.com</h1>
				</div>
			</section>

			<section class="whats-new">
				<div class="container">
					<h2>What’s new</h2>
					<ul>
						{newsItems.map((item) => (
							<li>
								<span class="date">
									{item.data.pubDate.toLocaleDateString('ja-JP').replace(/\//g, '.')}
								</span>
								<a href={`/blog/${item.id}`} class="news-link">
									{item.data.title}
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>

			<section class="profile">
				<div class="container">
					<h2>Profile</h2>
					<div class="profile-content">
						<div class="profile-icon">
							<img src="/images/profile.jpg" alt="Profile" />
						</div>
						<div class="profile-details">
							<h3>にちか / Nichika</h3>
							<p>農業、ものづくり、そして旅を愛する変人です。脳みそが全てを解決すると思っています。口癖は「どっかいきたい」。</p>
						</div>
					</div>
				</div>
			</section>
		</main>
</BaseLayout>

<style>
	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 4rem 1rem;
	}

	/* Hero Styles */
	.hero { position: relative; height: 100vh; overflow: hidden; }
	.hero-image { width: 100%; height: 100%; }
	.hero-image img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.6); }
	.hero-text {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		text-align: center;
		color: white;
		width: 100%;
	}
	.hero-text h1 { font-size: 3.5rem; letter-spacing: 0.1rem; margin: 0; }

	/* What's New & Profile */
	.whats-new ul { list-style: none; padding: 0; }
	.whats-new li { border-bottom: 1px solid #eee; padding: 1rem 0; display: flex; gap: 2rem; }
	.news-link {
		text-decoration: none;
		color: var(--primary-color);
		transition: color 0.2s;
		flex: 1;
	}
	.news-link:hover {
		color: var(--accent-color);
	}
	.date { color: #888; font-family: monospace; }

	.profile { background: #fafafa; }
	.profile-content { display: flex; align-items: center; gap: 3rem; margin-top: 2rem; }
	.profile-icon img { width: 150px; height: 150px; border-radius: 50%; object-fit: cover; }
	.profile-details h3 { margin-top: 0; }

	@media (max-width: 768px) {
		.hero-text h1 { font-size: 2rem; }
		.profile-content { flex-direction: column; text-align: center; }
	}
</style>