---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// すべての記事を取得（'blog' コレクション）
const allPosts = await getCollection('blog');

// 安全に日付順（新しい順）にソート
const sortedPosts = [...allPosts].sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// 重複のないカテゴリーリストを作成
const categories = [...new Set(sortedPosts.map((post) => post.data.category))];
---

<BaseLayout title="ブログ記事一覧 | にちか.com">
	<main class="container">
		<h1>Blog Archive (記事一覧)</h1>

		<section>
			<div class="category-list">
				<span class="category-label">Filter:</span>
				<a href="/blog" class="category-link active">All</a>
				{categories.map((category) => (
					<a href={`/blog/category/${category}`} class="category-link">{category}</a>
				))}
			</div>
		</section>

		<section class="post-list">
			{sortedPosts.length > 0 ? (
				sortedPosts.map(post => (
					<article class="post-item">
						<div class="post-meta">
							<time class="post-date" datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('ja-JP')}
							</time>
							<a href={`/blog/category/${post.data.category}`} class="tag">{post.data.category}</a>
						</div>
						<div class="post-details">
							<h2 class="post-title">
								<a href={`/blog/${post.id}`}>{post.data.title}</a>
							</h2>
							<p class="post-desc">{post.data.description}</p>
						</div>
					</article>
				))
			) : (
				<p>記事が見つかりませんでした。src/content/blog/ 内にMarkdownファイルがあるか確認してください。</p>
			)}
		</section>
	</main>
</BaseLayout>

    <style>
      .container { max-width: 900px; margin: 0 auto; padding: 6rem 1rem; }

      h1 { border-left: 5px solid #0070f3; padding-left: 1rem; margin-bottom: 3rem; }

      /* Category Filter */
      .category-list { margin-bottom: 4rem; display: flex; gap: 0.8rem; flex-wrap: wrap; align-items: center; }
      .category-label { font-weight: bold; font-size: 0.9rem; margin-right: 0.5rem; }
      .category-link { padding: 0.5rem 1rem; background: #f4f4f4; border-radius: 30px; text-decoration: none; color: #666; font-size: 0.85rem; transition: all 0.3s; }
      .category-link:hover { background: #0070f3; color: white !important; }
      .category-link.active { background: #0070f3; color: white !important; }

      /* Post List */
      .post-list { display: flex; flex-direction: column; gap: 3rem; }
      .post-item { border-bottom: 1px solid #eee; padding-bottom: 3rem; display: grid; grid-template-columns: 150px 1fr; gap: 2rem; }
      .post-meta { display: flex; flex-direction: column; gap: 0.5rem; }
      .post-date { color: #999; font-family: monospace; font-size: 1rem; }
      .tag { font-size: 0.75rem; background: #eef6ff; color: #0070f3; padding: 0.2rem 0.6rem; border-radius: 4px; width: fit-content; }
      
      .post-title { font-size: 1.6rem; margin: 0 0 1rem 0; line-height: 1.4; }
      .post-title a { text-decoration: none; color: #222; transition: color 0.2s; }
      .post-title a:hover { color: #0070f3; }
      .post-desc { color: #666; margin: 0; font-size: 1rem; }

      @media (max-width: 600px) {
        .post-item { grid-template-columns: 1fr; gap: 0.5rem; }
        .post-meta { flex-direction: row; align-items: center; gap: 1rem; }
      }
    </style>