---
interface Props {
	title: string;
	description?: string;
	headerOpacity?: string;
}

const { 
	title, 
	description = "時代の先端をいくサイト にちか.com", 
	headerOpacity = "0.8" 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<header style={`background-color: rgba(0, 0, 0, ${headerOpacity});`}>
			<div class="header-container">
				<a href="/" class="logo">にちか.com</a>
				<nav>
					<ul class="nav-links">
						<li><a href="/about">About me</a></li>
						<li><a href="/blog">Blog</a></li>
						<li><a href="/service">Service</a></li>
						<li><a href="/fanclub">Fan club</a></li>
						<li><a href="/contact">Contact</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<slot />

		<footer>
			<p>&copy; 2024 にちか.com</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--primary-color: #333;
		--accent-color: #0070f3;
	}
	body {
		margin: 0;
		padding: 0;
		font-family: 'Noto Sans JP', sans-serif;
		color: var(--primary-color);
		line-height: 1.6;
	}
	/* Layout Header */
	header {
		position: fixed;
		top: 0;
		width: 100%;
		z-index: 100;
		padding: 1rem 0;
		backdrop-filter: blur(10px);
		transition: background-color 0.3s;
	}
	.header-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}
	.logo { color: white; font-weight: bold; font-size: 1.5rem; text-decoration: none; }
	.nav-links { display: flex; list-style: none; gap: 2rem; margin: 0; }
	.nav-links a { color: white; text-decoration: none; font-weight: bold; }
	
	footer { text-align: center; padding: 2rem; border-top: 1px solid #eee; margin-top: 4rem; }

	@media (max-width: 768px) {
		.header-container { flex-direction: column; gap: 0.5rem; }
		.nav-links { gap: 0.8rem; font-size: 0.8rem; padding: 0; }
	}
</style>